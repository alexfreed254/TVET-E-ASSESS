# TVET e-ASSESS Environment Variables Template
# Copy this file to backend/.env and frontend/.env and fill in your values

# ============================================
# BACKEND (.env in backend/ directory)
# ============================================

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# JWT Configuration
SECRET_KEY=generate-with-python-secrets-token-urlsafe-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend.onrender.com

# Application Settings
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# File Upload Settings
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.pdf,.doc,.docx,.mp4,.avi,.mov

# Database Connection (Optional)
DATABASE_URL=postgresql://postgres:[password]@db.your-project-id.supabase.co:5432/postgres

# ============================================
# FRONTEND (.env in frontend/ directory)
# ============================================

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# API Configuration
VITE_API_URL=http://localhost:8000
# VITE_API_URL=https://your-backend.onrender.com

# Application Settings
VITE_APP_NAME=TVET e-ASSESS
VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=development

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=true
