# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Application Configuration
APP_NAME="TVET e-ASSESS"
APP_VERSION="1.0.0"
ENVIRONMENT=development
DEBUG=True

# API Configuration
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# File Upload Configuration
MAX_FILE_SIZE_MB=100
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp
ALLOWED_VIDEO_EXTENSIONS=mp4,mov,webm
ALLOWED_AUDIO_EXTENSIONS=mp3,wav,m4a
ALLOWED_DOCUMENT_EXTENSIONS=pdf,docx,xlsx

# Storage Buckets
EVIDENCE_BUCKET=assessment-evidence
DOCUMENTS_BUCKET=assessment-documents
REPORTS_BUCKET=generated-reports

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/tvet_eassess

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-password
SMTP_FROM=noreply@tvet-eassess.co.ke

# Institution Configuration
INSTITUTION_NAME=Your TVET Institution
INSTITUTION_CODE=TVET001

# Assessment Configuration
DEFAULT_ORAL_MAX_MARKS=10
DEFAULT_PRACTICAL_MAX_MARKS=100
ENABLE_COMPETENCY_OUTCOMES=True
